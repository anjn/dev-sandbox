#!/usr/bin/env bash

set -euo pipefail

port=${SANDBOX_SSH_PORT:?SANDBOX_SSH_PORT is required}
if [[ ! $port =~ ^[0-9]+$ ]] || ((port < 1024 || port > 65535)); then
    echo "Invalid SANDBOX_SSH_PORT: $port" >&2
    exit 1
fi

install -d -m 0755 /run/sshd /var/lib/dev-sandbox/ssh /etc/dev-sandbox

authorized_keys_source=/run/dev-sandbox/authorized_keys.source
authorized_keys=/etc/dev-sandbox/authorized_keys
if [[ ! -s $authorized_keys_source ]]; then
    echo "SSH authorized_keys source is missing or empty: $authorized_keys_source" >&2
    exit 1
fi
install -o ubuntu -g ubuntu -m 0600 -- "$authorized_keys_source" "$authorized_keys"

host_key=/var/lib/dev-sandbox/ssh/ssh_host_ed25519_key
if [[ ! -s $host_key ]]; then
    ssh-keygen -q -t ed25519 -N '' -f "$host_key"
fi
chown root:root "$host_key" "$host_key.pub"
chmod 0600 "$host_key"
chmod 0644 "$host_key.pub"

/usr/sbin/sshd -t
exec /usr/sbin/sshd -D -e -p "$port"
