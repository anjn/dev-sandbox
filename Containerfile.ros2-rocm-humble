ARG BASE_IMAGE=docker.io/rocm/dev-ubuntu-22.04:7.2.2-complete
FROM ${BASE_IMAGE}

ARG MESA_APT_PPA=ppa:kisak/turtle
ARG ROS_APT_SOURCE_URL=http://packages.ros.org/ros2/ubuntu

USER root

ENV TZ=Asia/Tokyo \
    LANG=ja_JP.UTF-8 \
    LC_CTYPE=ja_JP.UTF-8

RUN getent group ubuntu >/dev/null || groupadd --gid 1000 ubuntu; \
    id --user ubuntu >/dev/null 2>&1 || \
        useradd --uid 1000 --gid ubuntu --create-home --shell /bin/bash ubuntu

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    ca-certificates \
    curl \
    gnupg \
    locales \
    software-properties-common && \
    add-apt-repository -y universe && \
    curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    . /etc/os-release && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] $ROS_APT_SOURCE_URL $UBUNTU_CODENAME main" \
        > /etc/apt/sources.list.d/ros2.list && \
    if [ -n "$MESA_APT_PPA" ]; then add-apt-repository -y "$MESA_APT_PPA"; fi && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    rqt_packages=$(apt-cache pkgnames ros-humble-rqt | grep -Ev -- '-dbgsym$' | sort) && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential \
    cmake \
    git \
    git-lfs \
    iproute2 \
    jq \
    less \
    libgl1-mesa-dri \
    locales \
    mesa-utils \
    mesa-vulkan-drivers \
    net-tools \
    openssh-server \
    pkg-config \
    python3-pip \
    python3-yaml \
    ros-humble-compressed-image-transport \
    ros-humble-image-transport \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-ros2bag \
    ros-humble-rosbag2 \
    ros-humble-rviz2 \
    ros-humble-tf2-tools \
    sudo \
    tcpdump \
    vim \
    vulkan-tools \
    x11-apps \
    xauth \
    $rqt_packages && \
    locale-gen ja_JP.UTF-8 && update-locale LANG=ja_JP.UTF-8 && \
    usermod -aG sudo ubuntu && \
    echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ubuntu && \
    chmod 0440 /etc/sudoers.d/ubuntu && \
    rm -f /etc/ssh/ssh_host_* && \
    rm -rf /var/lib/apt/lists/*

COPY container/sshd_config /etc/ssh/sshd_config.d/99-dev-sandbox.conf
COPY container/start-sshd /usr/local/sbin/dev-sandbox-sshd
COPY scripts/preflight-ros2-tools scripts/preflight-ros2-rocm scripts/run-rviz /usr/local/bin/

RUN chmod 0755 /usr/local/sbin/dev-sandbox-sshd \
    /usr/local/bin/preflight-ros2-tools \
    /usr/local/bin/preflight-ros2-rocm \
    /usr/local/bin/run-rviz && \
    install -d -m 0700 -o ubuntu -g ubuntu /tmp/runtime-ubuntu && \
    passwd -d ubuntu && \
    printf '\nsource /opt/ros/humble/setup.bash\n' >> /home/ubuntu/.bashrc && \
    chown ubuntu:ubuntu /home/ubuntu/.bashrc

USER ubuntu
