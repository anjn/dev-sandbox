#!/usr/bin/env bash

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "$0")")/lib/sandbox.sh"

if (($# > 1)); then
    echo "Usage: $0 [HOST]" >&2
    exit 2
fi

sandbox_load_ssh_port || {
    echo "SSH port is not assigned for $CONTAINER_NAME. Run ./up first." >&2
    exit 1
}
sandbox_print_ssh_info "${1:-}"
