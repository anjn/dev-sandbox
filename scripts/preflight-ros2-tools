#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<EOF
Usage: $0 --interface NIC

Examples:
  $0 --interface lo
  $0 --interface enp5s0
EOF
}

interface=""

while (($#)); do
    case "$1" in
        --interface)
            shift
            (($#)) || {
                echo "Missing value after --interface." >&2
                usage >&2
                exit 2
            }
            interface=$1
            ;;
        --interface=*)
            interface=${1#*=}
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

[[ -n $interface ]] || {
    echo "--interface is required." >&2
    usage >&2
    exit 2
}

failures=0

pass() {
    printf '[OK] %s\n' "$1"
}

fail() {
    printf '[FAIL] %s\n' "$1" >&2
    failures=$((failures + 1))
}

require_command() {
    local command_name=$1

    if command -v "$command_name" >/dev/null 2>&1; then
        pass "command found: $command_name"
    else
        fail "command not found: $command_name"
    fi
}

require_command glxinfo
require_command vulkaninfo
require_command ip

echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"
if [[ ${XDG_SESSION_TYPE:-} == x11 ]]; then
    pass "XDG_SESSION_TYPE is x11"
else
    fail "XDG_SESSION_TYPE must be x11"
fi

if glx_output=$(glxinfo -B 2>&1); then
    echo
    echo "$glx_output"
    echo
    if grep -Eiq 'llvmpipe|software rasterizer' <<< "$glx_output"; then
        fail "glxinfo is using llvmpipe/software rendering"
    else
        pass "glxinfo is not using llvmpipe"
    fi
    if grep -Eiq 'AMD|Radeon' <<< "$glx_output"; then
        pass "glxinfo reports AMD/Radeon"
    else
        fail "glxinfo does not report AMD/Radeon"
    fi
else
    echo "$glx_output" >&2
    fail "glxinfo -B failed"
fi

if vulkan_output=$(vulkaninfo --summary 2>&1); then
    echo
    echo "$vulkan_output"
    echo
    if grep -Eiq 'AMD Radeon|RADV|radv' <<< "$vulkan_output"; then
        pass "vulkaninfo reports AMD Radeon/RADV"
    else
        fail "vulkaninfo does not report AMD Radeon/RADV"
    fi
else
    echo "$vulkan_output" >&2
    fail "vulkaninfo --summary failed"
fi

if [[ -f /autoware_data/config/cyclonedds.xml ]]; then
    pass "CycloneDDS config exists: /autoware_data/config/cyclonedds.xml"
else
    fail "CycloneDDS config missing: /autoware_data/config/cyclonedds.xml"
fi

if [[ -n ${ROS_DOMAIN_ID:-} ]]; then
    pass "ROS_DOMAIN_ID is set: $ROS_DOMAIN_ID"
else
    fail "ROS_DOMAIN_ID is not set"
fi

if [[ ${ROS_LOCALHOST_ONLY:-0} == 1 ]]; then
    fail "ROS_LOCALHOST_ONLY must not be 1"
else
    pass "ROS_LOCALHOST_ONLY is not 1"
fi

if ip addr show dev "$interface" >/dev/null 2>&1; then
    pass "network interface exists: $interface"
else
    fail "network interface not found: $interface"
fi

if ((failures > 0)); then
    echo
    echo "preflight failed with $failures issue(s)." >&2
    exit 1
fi

echo
echo "preflight passed."
