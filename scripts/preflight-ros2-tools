#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<EOF
Usage: $0
EOF
}

while (($#)); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

failures=0

pass() {
    printf '[OK] %s\n' "$1"
}

fail() {
    printf '[FAIL] %s\n' "$1" >&2
    failures=$((failures + 1))
}

require_command() {
    local command_name=$1

    if command -v "$command_name" >/dev/null 2>&1; then
        pass "command found: $command_name"
    else
        fail "command not found: $command_name"
    fi
}

require_command glxinfo
require_command vulkaninfo

echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"
if [[ ${XDG_SESSION_TYPE:-} == x11 ]]; then
    pass "XDG_SESSION_TYPE is x11"
else
    fail "XDG_SESSION_TYPE must be x11"
fi

if glx_output=$(glxinfo -B 2>&1); then
    echo
    echo "$glx_output"
    echo
    if grep -Eiq 'llvmpipe|software rasterizer' <<< "$glx_output"; then
        fail "glxinfo is using llvmpipe/software rendering"
    else
        pass "glxinfo is not using llvmpipe"
    fi
    if grep -Eiq 'AMD|Radeon' <<< "$glx_output"; then
        pass "glxinfo reports AMD/Radeon"
    else
        fail "glxinfo does not report AMD/Radeon"
    fi
else
    echo "$glx_output" >&2
    fail "glxinfo -B failed"
fi

if vulkan_output=$(vulkaninfo --summary 2>&1); then
    echo
    echo "$vulkan_output"
    echo
    if grep -Eiq 'AMD Radeon|RADV|radv|NVIDIA|Mesa' <<< "$vulkan_output"; then
        pass "vulkaninfo reports a GPU/Vulkan driver"
    else
        fail "vulkaninfo does not report an expected GPU/Vulkan driver"
    fi
else
    echo "$vulkan_output" >&2
    fail "vulkaninfo --summary failed"
fi

if [[ -f /opt/ros/humble/setup.bash ]]; then
    # shellcheck disable=SC1091
    source /opt/ros/humble/setup.bash
    pass "ROS 2 Humble setup exists"
else
    fail "ROS 2 Humble setup missing: /opt/ros/humble/setup.bash"
fi

if ros2 --help >/dev/null 2>&1; then
    pass "ros2 CLI is available"
else
    fail "ros2 CLI failed"
fi

if ((failures > 0)); then
    echo
    echo "preflight failed with $failures issue(s)." >&2
    exit 1
fi

echo
echo "preflight passed."
