#!/usr/bin/env bash

set -euo pipefail

source /opt/ros/humble/setup.bash

echo "ROS environment:"
env | grep -E '^(ROS|RMW|CYCLONE)' | sort || true

echo
echo "ros2 doctor --report:"
ros2 doctor --report || echo "ros2 doctor returned a non-zero status." >&2

echo
echo "ros2 topic list:"
topics=$(ros2 topic list)
printf '%s\n' "$topics"

echo
echo "AWSIM-like topics:"
interesting_topics=$(printf '%s\n' "$topics" | grep -Ei 'camera|image|lidar|pointcloud|imu|gnss|vehicle|tf' || true)
if [[ -n $interesting_topics ]]; then
    printf '%s\n' "$interesting_topics"
else
    echo "No matching topics found."
fi

representative_topic=$(printf '%s\n' "$interesting_topics" | awk 'NF { print; exit }')
if [[ -n $representative_topic ]]; then
    echo
    echo "ros2 topic hz $representative_topic:"
    timeout "${ROS2_TOPIC_HZ_TIMEOUT:-10s}" ros2 topic hz "$representative_topic" || \
        echo "ros2 topic hz timed out or returned a non-zero status." >&2
fi
