#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
    ps)
        if [[ ${FAKE_PODMAN_PS_FAIL:-0} == 1 ]]; then
            echo "fake podman ps failure" >&2
            exit 125
        fi
        if [[ -f $FAKE_PODMAN_DATA/containers ]]; then
            cat -- "$FAKE_PODMAN_DATA/containers"
        fi
        ;;
    inspect)
        shift
        format=""
        while (($# > 1)); do
            case "$1" in
                --format)
                    format=$2
                    shift 2
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        container_name=${1:-}
        fixture="$FAKE_PODMAN_DATA/inspect.$container_name"
        [[ -f $fixture ]] || {
            echo "No inspect fixture for $container_name" >&2
            exit 1
        }
        case "$format" in
            '{{.ImageName}}')
                sed -n 's/^IMAGE=//p' "$fixture"
                ;;
            '{{.State.StartedAt}}')
                sed -n 's/^STARTED=//p' "$fixture"
                ;;
            *)
                cat -- "$fixture"
                ;;
        esac
        ;;
    *)
        echo "Unsupported fake podman command: ${1:-}" >&2
        exit 2
        ;;
esac
