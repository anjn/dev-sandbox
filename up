#!/usr/bin/env bash

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "$0")")/lib/sandbox.sh"

platform=$(sandbox_resolve_platform)

sandbox_require_commands podman podman-compose
if [[ $platform == jetson ]]; then
    sandbox_check_jetson_cdi
fi

sandbox_compose "$platform" up -d

podman ps -a
