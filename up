#!/usr/bin/env bash

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "$0")")/lib/sandbox.sh"

sandbox_parse_up_args "$@"
if ((UP_HELP_REQUESTED)); then
    exit 0
fi

role=$(sandbox_resolve_role)
platform=$(sandbox_resolve_platform)
sandbox_check_role_platform "$role" "$platform"

sandbox_require_commands flock install podman podman-compose ssh-keygen ss stat
if ((${#EXTRA_MOUNT_SOURCES[@]})); then
    sandbox_require_commands mktemp python3
fi
if [[ $role == base && $platform == jetson ]]; then
    sandbox_check_jetson_cdi
fi
sandbox_check_ssh_authorized_keys
sandbox_prepare_role_environment "$role"
sandbox_prepare_ssh_port

if ((${#EXTRA_MOUNT_SOURCES[@]})); then
    extra_mount_override=$(mktemp -- "${TMPDIR:-/tmp}/dev-sandbox-mounts.XXXXXX.yaml")
    cleanup_extra_mount_override() {
        rm -f -- "$extra_mount_override"
    }
    trap cleanup_extra_mount_override EXIT

    sandbox_render_extra_mounts > "$extra_mount_override"
    SANDBOX_COMPOSE_OVERRIDE_FILE="$extra_mount_override" \
        sandbox_compose "$platform" "$role" up -d
else
    sandbox_compose "$platform" "$role" up -d
fi

sandbox_write_metadata "$role" "$platform"
podman ps -a
sandbox_print_ssh_info
