#!/usr/bin/env bash

set -euo pipefail

RULE_FILE=/etc/udev/rules.d/99-dev-sandbox-rocm-gpu-acl.rules

usage() {
    cat <<EOF
Usage:
  sudo $0 [USER]
  sudo $0 --remove [USER]

Install or remove a user-specific ROCm GPU device ACL udev rule.
USER defaults to SUDO_USER.
EOF
}

if (($# > 2)); then
    usage >&2
    exit 2
fi

remove=0
if [[ ${1:-} == --remove ]]; then
    remove=1
    shift
fi

if (($# > 1)); then
    usage >&2
    exit 2
fi

if ((EUID != 0)); then
    echo "Run this command with sudo." >&2
    usage >&2
    exit 1
fi

target_user=${1:-${SUDO_USER:-}}
if [[ -z $target_user || $target_user == root ]]; then
    echo "Specify the non-root Podman user explicitly." >&2
    usage >&2
    exit 1
fi
if [[ ! $target_user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
    echo "Invalid user name: $target_user" >&2
    exit 1
fi
if ! getent passwd "$target_user" >/dev/null; then
    echo "User does not exist: $target_user" >&2
    exit 1
fi

for command_name in install setfacl udevadm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Required command not found: $command_name" >&2
        echo "Install the acl and udev packages, then retry." >&2
        exit 1
    fi
done

remove_acl() {
    local device

    for device in /dev/kfd /dev/dri/renderD*; do
        [[ -e $device ]] || continue
        setfacl -x "u:$target_user" "$device" 2>/dev/null || true
    done
}

if ((remove)); then
    rm -f -- "$RULE_FILE"
    udevadm control --reload-rules
    remove_acl
    echo "Removed ROCm GPU ACL rule for $target_user."
    exit 0
fi

setfacl_path=$(command -v setfacl)
temporary_rule=$(mktemp)
cleanup() {
    rm -f -- "$temporary_rule"
}
trap cleanup EXIT

{
    echo '# Generated by dev-sandbox/setup-rocm-gpu-access.'
    echo "# Grants only the existing Podman user access; device modes and groups are unchanged."
    printf 'ACTION=="add", KERNEL=="kfd", RUN+="%s -m u:%s:rw- /dev/kfd"\n' \
        "$setfacl_path" "$target_user"
    printf 'ACTION=="add", SUBSYSTEM=="drm", KERNEL=="renderD*", RUN+="%s -m u:%s:rw- /dev/dri/%%k"\n' \
        "$setfacl_path" "$target_user"
} > "$temporary_rule"

install -D -m 0644 "$temporary_rule" "$RULE_FILE"
udevadm control --reload-rules

applied=0
for device in /dev/kfd /dev/dri/renderD*; do
    [[ -e $device ]] || continue
    setfacl -m "u:$target_user:rw" "$device"
    applied=$((applied + 1))
done

echo "Installed $RULE_FILE for $target_user."
echo "Applied ACLs to $applied existing device node(s)."
