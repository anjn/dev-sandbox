#!/usr/bin/env bash

set -euo pipefail

RULE_FILE=/etc/udev/rules.d/99-dev-sandbox-jetson-gpu-acl.rules

RW_DEVICES=(
    /dev/nvmap
    /dev/nvhost-as-gpu
    /dev/nvhost-ctrl-gpu
    /dev/nvhost-gpu
    /dev/nvhost-nvsched-gpu
    /dev/nvhost-power-gpu
    /dev/nvhost-tsg-gpu
    /dev/nvgpu/igpu0/as
    /dev/nvgpu/igpu0/channel
    /dev/nvgpu/igpu0/ctrl
    /dev/nvgpu/igpu0/power
    /dev/nvgpu/igpu0/tsg
    /dev/dri/renderD128
    /dev/dri/renderD129
)
READ_DEVICES=(
    /dev/nvgpu/igpu0/nvsched
)

usage() {
    cat <<EOF
Usage:
  sudo $0 [USER]
  sudo $0 --remove [USER]

Install or remove a user-specific Jetson GPU device ACL udev rule.
USER defaults to SUDO_USER.
EOF
}

if (($# > 2)); then
    usage >&2
    exit 2
fi

remove=0
if [[ ${1:-} == --remove ]]; then
    remove=1
    shift
fi

if (($# > 1)); then
    usage >&2
    exit 2
fi

if ((EUID != 0)); then
    echo "Run this command with sudo." >&2
    usage >&2
    exit 1
fi

target_user=${1:-${SUDO_USER:-}}
if [[ -z $target_user || $target_user == root ]]; then
    echo "Specify the non-root Podman user explicitly." >&2
    usage >&2
    exit 1
fi
if [[ ! $target_user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
    echo "Invalid user name: $target_user" >&2
    exit 1
fi
if ! getent passwd "$target_user" >/dev/null; then
    echo "User does not exist: $target_user" >&2
    exit 1
fi

for command_name in getfacl install setfacl udevadm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Required command not found: $command_name" >&2
        echo "Install the acl and udev packages, then retry." >&2
        exit 1
    fi
done

user_groups=$(id -nG "$target_user")
for required_group in video render; do
    if ! grep -Fqw "$required_group" <<< "$user_groups"; then
        echo "User $target_user must belong to the $required_group group." >&2
        exit 1
    fi
done

remove_acl() {
    local device

    for device in "${RW_DEVICES[@]}" "${READ_DEVICES[@]}"; do
        [[ -e $device ]] || continue
        setfacl -x "u:$target_user" "$device" 2>/dev/null || true
    done
}

if ((remove)); then
    rm -f -- "$RULE_FILE"
    udevadm control --reload-rules
    remove_acl
    echo "Removed Jetson GPU ACL rule for $target_user."
    exit 0
fi

setfacl_path=$(command -v setfacl)
temporary_rule=$(mktemp)
cleanup() {
    rm -f -- "$temporary_rule"
}
trap cleanup EXIT

{
    echo '# Generated by dev-sandbox/setup-jetson-gpu-access.'
    echo "# Grants only the existing Podman user access; device modes and groups are unchanged."
    for device in "${RW_DEVICES[@]}"; do
        printf 'ACTION=="add", ENV{DEVNAME}=="%s", RUN+="%s -m u:%s:rw- %s"\n' \
            "$device" "$setfacl_path" "$target_user" "$device"
    done
    for device in "${READ_DEVICES[@]}"; do
        printf 'ACTION=="add", ENV{DEVNAME}=="%s", RUN+="%s -m u:%s:r-- %s"\n' \
            "$device" "$setfacl_path" "$target_user" "$device"
    done
} > "$temporary_rule"

install -D -m 0644 "$temporary_rule" "$RULE_FILE"
udevadm control --reload-rules

applied=0
for device in "${RW_DEVICES[@]}"; do
    [[ -e $device ]] || continue
    setfacl -m "u:$target_user:rw" "$device"
    applied=$((applied + 1))
done
for device in "${READ_DEVICES[@]}"; do
    [[ -e $device ]] || continue
    setfacl -m "u:$target_user:r" "$device"
    applied=$((applied + 1))
done

echo "Installed $RULE_FILE for $target_user."
echo "Applied ACLs to $applied existing device node(s)."
